#!/bin/sh
# A stand-in for gh, GitHub's command line, for this pattern's own run. pattern.sh puts this
# directory first on PATH, so the applier's `gh api` calls reach it and never GitHub. It answers the
# calls the applier and the auditor make, from the fixtures beside it, as GitHub answers them; it
# keeps what they change in state/, beside it, and records each call, its method, its path and its
# input, as one line of state/calls.jsonl. A call it does not know is HTTP 404, printed as gh prints
# one.
#
# The fixture repos/<owner>/<name>/bases lists, one to a line, the branches whose ruleset the
# applier bypasses; a merge into any other base is refused, HTTP 405, as a ruleset whose bypass list
# leaves out the applier refuses it. Without that file, every base takes a merge.
#
# It plays what others may do between two calls, each once, when a file of state/ names pull
# request <n>:
#   push-<n>      holds a commit: the next read returns the pull request as it was and then moves its
#                 head to that commit, as a push landing between the applier's read and its merge would;
#   retarget-<n>  holds a branch: the next read returns it as it was and then sets its base to that
#                 branch, as its author editing it would.
#
# It plays GitHub failing from state/faults, whose lines are `METHOD PATH ANSWER`. A call takes off
# the first line of its method and path, and that line's ANSWER says what the call does:
#   ok      what it would with no fault, so that the next line of that call is for a later one;
#   CODE    nothing, and the answer is HTTP CODE, such as 503 when GitHub is unavailable, or 401
#           when the credential has lapsed;
#   CODE+   a merge call only: it merges, and the answer is HTTP CODE, as a reply lost on the way;
#   hollow  a merge call only: it merges nothing, and the answer says it merged.
set -euf

here=$(cd "$(dirname "$0")" && pwd)
state=$here/state
mkdir -p "$state/comments"

# fail CODE MESSAGE: GitHub's error, its body on standard output and gh's line on standard error, and
# gh's exit status.
fail() {
	jq -nc --arg m "$2" '{message: $m}'
	echo "gh: $2 (HTTP $1)" >&2
	exit 1
}

# reason CODE: GitHub's message for HTTP CODE.
reason() {
	case $1 in
	401) echo "Bad credentials" ;;
	502) echo "Bad Gateway" ;;
	503) echo "Service Unavailable" ;;
	*) echo "Server Error" ;;
	esac
}

[ "${1:-}" = api ] || { echo "the stand-in gh knows only gh api" >&2; exit 2; }
shift
method=GET path= input=
while [ $# -gt 0 ]; do
	case $1 in
	-X | --method) method=$2; shift 2 ;;
	--input) input=$2; shift 2 ;;
	-*) echo "the stand-in gh does not know $1" >&2; exit 2 ;;
	*) path=$1; shift ;;
	esac
done
body=null
if [ -n "$input" ]; then
	if [ "$input" = - ]; then body=$(jq -c .); else body=$(jq -c . "$input"); fi
fi
jq -nc --arg method "$method" --arg path "$path" --argjson input "$body" '{$method, $path, $input}' >>"$state/calls.jsonl"

# The path's parts, each of a name's form: letters, digits, '.', '_' and '-', never '.' or '..' alone.
IFS=/
# shellcheck disable=SC2086 # split on purpose; globbing is off (set -f)
set -- $path
unset IFS
for part; do
	case $part in
	'' | . | .. | *[!A-Za-z0-9._-]*) fail 404 "Not Found" ;;
	esac
done
[ "${1:-}" = repos ] && [ $# -ge 5 ] || fail 404 "Not Found"
repo=$2/$3
shift 3

fault=
if [ -f "$state/faults" ]; then
	hit=$(awk -v m="$method" -v p="$path" '$1 == m && $2 == p { print NR, $3; exit }' "$state/faults")
	if [ -n "$hit" ]; then
		sed "${hit%% *}d" "$state/faults" >"$state/faults.new"
		mv "$state/faults.new" "$state/faults"
		fault=${hit#* }
	fi
fi
case $fault in
'' | ok | *+ | hollow) ;;
*) fail "$fault" "$(reason "$fault")" ;;
esac

# pull N: sets f to the state file of pull request N, made from its fixture the first time; it fails
# when the fixtures hold no such pull request.
pull() {
	case $1 in *[!0-9]*) fail 404 "Not Found" ;; esac
	f=$state/pulls/$repo/$1.json
	if [ ! -f "$f" ]; then
		[ -f "$here/fixtures/repos/$repo/pulls/$1.json" ] || fail 404 "Not Found"
		mkdir -p "$state/pulls/$repo"
		cp "$here/fixtures/repos/$repo/pulls/$1.json" "$f"
	fi
}

case "$method $*" in
"GET pulls "*)
	[ $# -eq 2 ] || fail 404 "Not Found"
	pull "$2"
	cat "$f"
	if [ -f "$state/push-$2" ]; then
		jq --arg sha "$(cat "$state/push-$2")" '.head.sha = $sha' "$f" >"$f.new"
		mv "$f.new" "$f"
		rm "$state/push-$2"
	fi
	if [ -f "$state/retarget-$2" ]; then
		jq --arg ref "$(cat "$state/retarget-$2")" '.base.ref = $ref' "$f" >"$f.new"
		mv "$f.new" "$f"
		rm "$state/retarget-$2"
	fi
	;;
"PUT pulls "*" merge")
	[ $# -eq 3 ] || fail 404 "Not Found"
	pull "$2"
	[ "$(jq -r .merged "$f")" = false ] && [ "$(jq -r .state "$f")" = open ] ||
		fail 405 "Pull Request is not mergeable"
	bases=$here/fixtures/repos/$repo/bases
	[ ! -f "$bases" ] || grep -Fqx "$(jq -r .base.ref "$f")" "$bases" ||
		fail 405 "Repository rule violations found"
	sha=$(echo "$body" | jq -r '.sha // empty')
	[ -z "$sha" ] || [ "$sha" = "$(jq -r .head.sha "$f")" ] ||
		fail 409 "Head branch was modified. Review and try the merge again."
	if [ "$fault" != hollow ]; then
		jq '.merged = true | .merged_at = "2026-01-01T00:00:00Z" | .state = "closed"' "$f" >"$f.new"
		mv "$f.new" "$f"
	fi
	case $fault in *+) fail "${fault%+}" "$(reason "${fault%+}")" ;; esac
	jq -c '{sha: .merge_commit_sha, merged: true, message: "Pull Request successfully merged"}' "$f"
	;;
"POST issues "*" comments")
	[ $# -eq 3 ] || fail 404 "Not Found"
	pull "$2"
	n=$(($(ls "$state/comments" | wc -l) + 1001))
	echo "$body" | jq -c --arg repo "$repo" --arg pr "$2" --argjson id "$n" '{
		id: $id, body: .body,
		url: "https://api.github.com/repos/\($repo)/issues/comments/\($id)",
		html_url: "https://github.com/\($repo)/pull/\($pr)#issuecomment-\($id)"}' >"$state/comments/$n.json"
	cat "$state/comments/$n.json"
	;;
"GET issues comments "*)
	[ $# -eq 3 ] && [ -f "$state/comments/$3.json" ] || fail 404 "Not Found"
	cat "$state/comments/$3.json"
	;;
"POST statuses "*)
	[ $# -eq 2 ] || fail 404 "Not Found"
	echo "$body" | jq -c --arg sha "$2" '{sha: $sha, state, context, description, target_url}' >>"$state/statuses.jsonl"
	echo "$body" | jq -c '{state, context, description, target_url}'
	;;
"GET commits "*" pulls")
	# The merged pull requests whose merge commit is this one, in GitHub's short form of a pull
	# request, which has merged_at and no merged.
	[ $# -eq 3 ] || fail 404 "Not Found"
	mkdir -p "$state/pulls/$repo"
	find "$state/pulls/$repo" -name '*.json' -exec cat {} + |
		jq -sc --arg sha "$2" '[.[] | select(.merged and .merge_commit_sha == $sha) | del(.merged)]'
	;;
"GET commits "*" statuses")
	[ $# -eq 3 ] || fail 404 "Not Found"
	touch "$state/statuses.jsonl"
	jq -sc --arg sha "$2" '[.[] | select(.sha == $sha) | del(.sha)] | reverse' "$state/statuses.jsonl"
	;;
*)
	fail 404 "Not Found"
	;;
esac
