{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placket.tech/schema/0.1/card.json",
  "title": "Card",
  "description": "What can change a verdict under an Accord, hashed into every receipt (setup-contract-4): the protocol version, the decision module's kernel, and judges, the ordered list of the judges a maybe term may grant, each pinned by its name, version and hash, no two of one name. A schema compares whole entries, so uniqueItems refuses an entry repeated exactly; founding refuses one name with two versions or hashes (setup-contract-4).",
  "type": "object",
  "properties": {
    "spec": {
      "const": "0.1"
    },
    "kernel": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "hash": {
          "$ref": "hash.json"
        }
      },
      "required": [
        "version",
        "hash"
      ],
      "additionalProperties": false
    },
    "judges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "required": [
    "spec",
    "kernel",
    "judges"
  ],
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-z]+(?:[.+-][0-9a-z]+)*$"
    },
    "component": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "term.json#/$defs/label"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "hash": {
          "$ref": "hash.json"
        }
      },
      "required": [
        "name",
        "version",
        "hash"
      ],
      "additionalProperties": false
    }
  }
}
