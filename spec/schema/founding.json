{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placket.tech/schema/0.1/founding.json",
  "title": "Founding set",
  "description": "Everything an Accord is founded from; its typed hash is the Accord id (setup-contract-5). Each declaration is held as its seal (setup-contract-12). The order of declarations and bindings, by actor reference, is a rule of the text (setup-contract-10) that a schema cannot state, and so are that no two policy entries name one principal and that every binding's policy is the typed hash of this set's policy (setup-contract-3).",
  "type": "object",
  "properties": {
    "policy": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "term.json#/$defs/label"
          }
        },
        "principals": {
          "description": "One entry per principal: the principal and the roles it may grant (setup-contract-2, setup-contract-9). That no two entries name one principal is a rule of the text that a schema cannot state.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "principal": {
                "$ref": "reference.json"
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "term.json#/$defs/label"
                }
              }
            },
            "required": [
              "principal",
              "roles"
            ],
            "additionalProperties": false
          }
        },
        "supersedes": {
          "description": "The earlier Accord this one supersedes: its id and the id of its close receipt, two typed hashes, signed through each binding's policy hash (setup-contract-11).",
          "type": "object",
          "properties": {
            "accord": {
              "$ref": "hash.json"
            },
            "close": {
              "$ref": "hash.json"
            }
          },
          "required": [
            "accord",
            "close"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "roles",
        "principals"
      ],
      "additionalProperties": false
    },
    "mediator": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "reference.json"
        },
        "operator": {
          "$ref": "reference.json"
        },
        "runs": {
          "const": "process"
        }
      },
      "required": [
        "actor",
        "operator",
        "runs"
      ],
      "additionalProperties": false
    },
    "card": {
      "$ref": "card.json"
    },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A seal entry: the actor and the seal of its declaration, sha256: and the hex of the SHA-256 of a 32-byte salt and the declaration's canonical bytes (setup-contract-12). The declaration and its salt are the opening (opening.json).",
        "type": "object",
        "properties": {
          "actor": {
            "$ref": "reference.json"
          },
          "seal": {
            "$ref": "hash.json"
          }
        },
        "required": [
          "actor",
          "seal"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "binding.json"
      }
    }
  },
  "required": [
    "policy",
    "mediator",
    "card",
    "declarations",
    "bindings"
  ],
  "additionalProperties": false
}
