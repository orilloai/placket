{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placket.tech/schema/0.1/vector.json",
  "title": "Conformance vector",
  "description": "One conformance vector (conformance-vectors-1 to conformance-vectors-11). Every object is closed. The header is vector, spec and tests; operation says what the vector runs and which other members it holds.",
  "type": "object",
  "properties": {
    "vector": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "spec": {
      "const": "0.1"
    },
    "tests": {
      "type": "string",
      "pattern": "^[^\\n]*[^\\s\\n][^\\n]*$"
    },
    "operation": {
      "enum": [
        "canonical",
        "sign",
        "verify-signature",
        "found",
        "scenario",
        "verify",
        "reconcile",
        "conform"
      ]
    },
    "keys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "term.json#/$defs/label"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "input": true,
    "inputText": {
      "type": "string"
    },
    "inputHex": {
      "$ref": "#/$defs/hex"
    },
    "typeUri": {
      "type": "string"
    },
    "signer": {
      "$ref": "#/$defs/name"
    },
    "reference": {
      "type": "string"
    },
    "mediator": {
      "$ref": "#/$defs/name"
    },
    "founding": {
      "$ref": "founding.json"
    },
    "foundedAt": {
      "$ref": "timestamp.json"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "final": {
      "$ref": "#/$defs/final"
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receiptBytes"
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/answerBytes"
      }
    },
    "subset": {
      "type": "boolean"
    },
    "kernel": {
      "$ref": "hash.json"
    },
    "delivery": {
      "$ref": "delivery.json"
    },
    "accord": {
      "type": "string"
    },
    "card": {
      "type": "string"
    },
    "kept": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "term.json#/$defs/label"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "$ref": "predicate.json#/$defs/seq"
                },
                "hash": {
                  "$ref": "hash.json"
                }
              },
              "required": [
                "seq",
                "hash"
              ],
              "additionalProperties": false
            }
          },
          "delivered": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/receiptBytes"
            }
          }
        },
        "required": [
          "envelopes",
          "delivered"
        ],
        "additionalProperties": false
      }
    },
    "expect": {
      "type": "object"
    },
    "parties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "term.json#/$defs/label"
      },
      "additionalProperties": {
        "$ref": "reference.json"
      }
    }
  },
  "required": [
    "vector",
    "spec",
    "tests",
    "operation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "canonical"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "inputText",
            "inputHex",
            "expect"
          ]
        },
        "required": [
          "expect"
        ],
        "oneOf": [
          {
            "required": [
              "inputText"
            ]
          },
          {
            "required": [
              "inputHex"
            ]
          }
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/canonicalExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sign"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "keys",
            "input",
            "typeUri",
            "signer",
            "expect"
          ]
        },
        "required": [
          "keys",
          "input",
          "typeUri",
          "signer",
          "expect"
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/signExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify-signature"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "input",
            "inputText",
            "inputHex",
            "typeUri",
            "reference",
            "expect"
          ]
        },
        "required": [
          "typeUri",
          "reference",
          "expect"
        ],
        "oneOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "inputText"
            ]
          },
          {
            "required": [
              "inputHex"
            ]
          }
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/verifySignatureExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "found"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "input",
            "inputText",
            "inputHex",
            "foundedAt",
            "expect"
          ]
        },
        "required": [
          "foundedAt",
          "expect"
        ],
        "oneOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "inputText"
            ]
          },
          {
            "required": [
              "inputHex"
            ]
          }
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/foundExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "scenario"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "keys",
            "mediator",
            "founding",
            "foundedAt",
            "steps",
            "final"
          ]
        },
        "required": [
          "keys",
          "mediator",
          "founding",
          "foundedAt",
          "steps",
          "final"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "receipts",
            "reference",
            "expect"
          ]
        },
        "required": [
          "receipts",
          "reference",
          "expect"
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/verifyExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reconcile"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "receipts",
            "reference",
            "accord",
            "card",
            "kept",
            "expect",
            "parties"
          ]
        },
        "required": [
          "receipts",
          "reference",
          "accord",
          "card",
          "kept",
          "expect",
          "parties"
        ],
        "properties": {
          "expect": {
            "$ref": "#/$defs/reconcileExpect"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "conform"
          }
        }
      },
      "then": {
        "propertyNames": {
          "enum": [
            "vector",
            "spec",
            "tests",
            "operation",
            "accord",
            "reference",
            "founding",
            "receipts",
            "answers",
            "subset",
            "kernel",
            "delivery",
            "expect"
          ]
        },
        "required": [
          "accord",
          "receipts",
          "kernel",
          "expect"
        ],
        "properties": {
          "accord": {
            "$ref": "hash.json"
          },
          "expect": {
            "$ref": "#/$defs/conformExpect"
          }
        }
      }
    }
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "name": {
      "$ref": "term.json#/$defs/label"
    },
    "receiptBytes": {
      "type": "object",
      "properties": {
        "receipt": true,
        "receiptText": {
          "type": "string"
        },
        "receiptHex": {
          "$ref": "#/$defs/hex"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "canonicalExpect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "canonicalHex": {
              "$ref": "#/$defs/hex",
              "minLength": 2
            },
            "hash": {
              "$ref": "hash.json"
            }
          },
          "required": [
            "canonicalHex",
            "hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid-json",
                "invalid-string",
                "duplicate-key",
                "fractional-number",
                "unsafe-integer"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "code",
            "offset"
          ],
          "additionalProperties": false
        }
      ]
    },
    "signExpect": {
      "type": "object",
      "properties": {
        "signingBytesHex": {
          "$ref": "#/$defs/hex",
          "minLength": 2
        },
        "sig": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "signingBytesHex",
        "sig"
      ],
      "additionalProperties": false
    },
    "verifySignatureExpect": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "additionalProperties": false
    },
    "foundExpect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accord": {
              "$ref": "hash.json"
            },
            "card": {
              "$ref": "hash.json"
            }
          },
          "required": [
            "accord",
            "card"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "not-canonical",
                "invalid-shape",
                "binding-duplicate",
                "actor-reference",
                "declaration-signature",
                "term-invalid",
                "maybe-without-resolve",
                "judge-unknown",
                "binding-missing",
                "binding-principal",
                "binding-signature",
                "binding-role",
                "binding-policy",
                "binding-mediator",
                "binding-expired",
                "declaration-missing",
                "role-missing"
              ]
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "verifyCode": {
      "enum": [
        "reference",
        "not-canonical",
        "payload-type",
        "signature",
        "statement-type",
        "mediator",
        "chain",
        "release",
        "close",
        "after-close"
      ]
    },
    "verifyExpect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "verified"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "reference"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/verifyCode",
              "not": {
                "const": "reference"
              }
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reconcileExpect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "removed": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/actorReceipt"
              }
            },
            "unrecorded": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/actorReceipt"
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "actor": {
                    "$ref": "#/$defs/name"
                  },
                  "seq": {
                    "$ref": "predicate.json#/$defs/seq"
                  }
                },
                "required": [
                  "actor",
                  "seq"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "removed",
            "unrecorded",
            "missing"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "reference"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "not-canonical",
                "payload-type",
                "signature",
                "statement-type",
                "mediator",
                "chain",
                "release",
                "close",
                "after-close",
                "presented"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "kept"
            },
            "actor": {
              "$ref": "#/$defs/name"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "actor",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "actorReceipt": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/name"
        },
        "receiptId": {
          "$ref": "hash.json"
        }
      },
      "required": [
        "actor",
        "receiptId"
      ],
      "additionalProperties": false
    },
    "pairing": {
      "description": "A verdict and its reason pair as receipt-4 says: pass with ok, escalate with maybe, and block with any reason but ok.",
      "allOf": [
        {
          "if": {
            "required": [
              "verdict"
            ],
            "properties": {
              "verdict": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "ok"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "verdict"
            ],
            "properties": {
              "verdict": {
                "const": "escalate"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "maybe"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "verdict"
            ],
            "properties": {
              "verdict": {
                "const": "block"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": "ok"
                }
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "block",
            "escalate"
          ]
        },
        "reason": {
          "$ref": "predicate.json#/properties/reason"
        },
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        }
      },
      "required": [
        "verdict",
        "reason",
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A give's outcome: its crossing receipt, whose verdict and reason pair as receipt-4 says, and whose reason is never one only a resolution receipt has.",
      "allOf": [
        {
          "$ref": "#/$defs/pairing"
        },
        {
          "properties": {
            "reason": {
              "not": {
                "enum": [
                  "declined",
                  "cancelled",
                  "timeout",
                  "undeliverable",
                  "closed"
                ]
              }
            }
          }
        }
      ]
    },
    "tickOutcome": {
      "type": "object",
      "properties": {
        "verdict": {
          "const": "block"
        },
        "reason": {
          "const": "timeout"
        },
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        }
      },
      "required": [
        "verdict",
        "reason",
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A receipt a tick writes: the timeout of a question whose deadline it reached (maybe-5), block with reason timeout."
    },
    "rejection": {
      "type": "object",
      "properties": {
        "rejection": {
          "enum": [
            "not-a-member",
            "closed",
            "accord-full",
            "envelope-signature",
            "not-canonical",
            "extension-missing",
            "receiver-unknown",
            "accord-mismatch",
            "envelope-hash",
            "envelope-sequence",
            "one-part",
            "one-body",
            "url-unsupported",
            "part-metadata",
            "answer-call",
            "no-open-question",
            "not-an-answerer",
            "answer-body"
          ]
        }
      },
      "required": [
        "rejection"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "give",
            "get",
            "resolve",
            "tick",
            "close"
          ]
        }
      },
      "required": [
        "op"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "give"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/give"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "get"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/get"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "resolve"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/resolve"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "tick"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tick"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "close"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/close"
          }
        }
      ]
    },
    "give": {
      "properties": {
        "op": true,
        "at": {
          "$ref": "timestamp.json"
        },
        "as": {
          "$ref": "#/$defs/name"
        },
        "message": true,
        "messageText": {
          "type": "string"
        },
        "messageHex": {
          "$ref": "#/$defs/hex"
        },
        "envelope": true,
        "envelopeText": {
          "type": "string"
        },
        "envelopeHex": {
          "$ref": "#/$defs/hex"
        },
        "judge": {
          "description": "The judgment the give hands the decision: a judge's card name and its verdict (conformance-vectors-3, composition-7).",
          "type": "object",
          "properties": {
            "name": {
              "$ref": "term.json#/$defs/label"
            },
            "verdict": {
              "enum": [
                "pass",
                "block"
              ]
            }
          },
          "required": [
            "name",
            "verdict"
          ],
          "additionalProperties": false
        },
        "expect": {
          "oneOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "$ref": "#/$defs/rejection"
            }
          ]
        }
      },
      "required": [
        "at",
        "as",
        "expect"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "message"
              ]
            },
            {
              "required": [
                "messageText"
              ]
            },
            {
              "required": [
                "messageHex"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "envelope"
              ]
            },
            {
              "required": [
                "envelopeText"
              ]
            },
            {
              "required": [
                "envelopeHex"
              ]
            }
          ]
        }
      ]
    },
    "get": {
      "properties": {
        "op": true,
        "as": {
          "$ref": "#/$defs/name"
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "delivery": {
                  "$ref": "delivery.json"
                }
              },
              "required": [
                "delivery"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "none": {
                  "const": true
                }
              },
              "required": [
                "none"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "close": {
                  "$ref": "#/$defs/closeReceipt"
                }
              },
              "required": [
                "close"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/rejection"
            }
          ]
        }
      },
      "required": [
        "as",
        "expect"
      ],
      "additionalProperties": false
    },
    "resolve": {
      "description": "A resolve step (conformance-vectors-6): an answer step, holding callHex, the answer call's canonical bytes, and answer and salt, the answer's text and the answerer's salt, which the runner hands the mediator as given; by names the caller, and without it the caller is the call's from. Or the mediator's finding that nobody can answer question, undeliverable, which takes no caller. A step holds no action: the action and the release are inside callHex, which a schema cannot read, so the runner pairs them with expect.",
      "properties": {
        "op": true,
        "at": {
          "$ref": "timestamp.json"
        },
        "callHex": {
          "$ref": "#/$defs/hex"
        },
        "answer": {
          "type": "string"
        },
        "salt": {
          "$ref": "part.json#/$defs/salt"
        },
        "question": {
          "$ref": "hash.json"
        },
        "undeliverable": {
          "const": true
        },
        "by": {
          "$ref": "#/$defs/name"
        },
        "expect": {
          "oneOf": [
            {
              "$ref": "#/$defs/resolveOutcome"
            },
            {
              "$ref": "#/$defs/rejection"
            }
          ]
        }
      },
      "required": [
        "at",
        "expect"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "callHex"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "question"
                ]
              },
              {
                "required": [
                  "undeliverable"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "question",
            "undeliverable"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "callHex"
                ]
              },
              {
                "required": [
                  "answer"
                ]
              },
              {
                "required": [
                  "salt"
                ]
              },
              {
                "required": [
                  "by"
                ]
              }
            ]
          },
          "properties": {
            "expect": {
              "properties": {
                "verdict": {
                  "const": "block"
                },
                "reason": {
                  "const": "undeliverable"
                }
              }
            }
          }
        }
      ]
    },
    "tick": {
      "properties": {
        "op": true,
        "at": {
          "$ref": "timestamp.json"
        },
        "expect": {
          "type": "object",
          "properties": {
            "receipts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tickOutcome"
              }
            }
          },
          "required": [
            "receipts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "at",
        "expect"
      ],
      "additionalProperties": false
    },
    "final": {
      "type": "object",
      "properties": {
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receiptId": {
                "$ref": "hash.json"
              },
              "receipt": {
                "$ref": "receipt.json"
              }
            },
            "required": [
              "receiptId",
              "receipt"
            ],
            "additionalProperties": false
          }
        },
        "delivered": {
          "type": "object",
          "propertyNames": {
            "$ref": "term.json#/$defs/label"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "delivery.json"
            }
          }
        },
        "pending": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "hash.json"
          }
        }
      },
      "required": [
        "receipts",
        "delivered",
        "pending"
      ],
      "additionalProperties": false
    },
    "resolveOutcome": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "reason": {
          "$ref": "predicate.json#/properties/reason"
        },
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        },
        "release": {
          "$ref": "#/$defs/releaseOutcome"
        }
      },
      "required": [
        "verdict",
        "reason",
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A resolve step's outcome: its resolution receipt, whose verdict and reason pair as receipt-4 says, and the release receipt's outcome when one was written.",
      "allOf": [
        {
          "$ref": "#/$defs/pairing"
        }
      ]
    },
    "releaseOutcome": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "reason": {
          "$ref": "predicate.json#/properties/reason"
        },
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        }
      },
      "required": [
        "verdict",
        "reason",
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A release receipt's outcome (maybe-10): composition's verdict and reason, paired as receipt-4 says, never a reason only a closing has.",
      "allOf": [
        {
          "$ref": "#/$defs/pairing"
        },
        {
          "properties": {
            "reason": {
              "not": {
                "enum": [
                  "declined",
                  "cancelled",
                  "timeout",
                  "undeliverable",
                  "closed"
                ]
              }
            }
          }
        }
      ]
    },
    "answerBytes": {
      "description": "An answer call a verifier is given: as a JSON value, call, whose bytes are its canonical form, or as hex, callHex (conformance-vectors-8).",
      "type": "object",
      "properties": {
        "call": {
          "$ref": "answer.json"
        },
        "callHex": {
          "$ref": "#/$defs/hex"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "callHex"
          ]
        }
      ]
    },
    "conformExpect": {
      "description": "A conform vector's result (verify-2): the first failure, its code, a validity code of section 8 or a conformance code, and its index; or the whole list conforms, with the number of answers witnessed and unwitnessed, the calls that match no receipt, whether the card's module is the trusted one, and, with a delivery, that its body is the part of its receipt.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "reference",
                "not-canonical",
                "payload-type",
                "signature",
                "statement-type",
                "mediator",
                "chain",
                "release",
                "close",
                "after-close",
                "founding",
                "accord",
                "party",
                "decision",
                "witness",
                "body"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": -1
            }
          },
          "required": [
            "code",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "conforms": {
              "type": "boolean"
            },
            "witnessed": {
              "type": "integer",
              "minimum": 0
            },
            "unwitnessed": {
              "type": "integer",
              "minimum": 0
            },
            "unmatched": {
              "type": "integer",
              "minimum": 0
            },
            "module": {
              "type": "boolean"
            },
            "body": {
              "const": true
            }
          },
          "required": [
            "conforms",
            "witnessed",
            "unwitnessed",
            "unmatched",
            "module"
          ],
          "additionalProperties": false
        }
      ]
    },
    "closeReceipt": {
      "type": "object",
      "properties": {
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        }
      },
      "required": [
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A close receipt and its id (close-2)."
    },
    "closeOutcome": {
      "type": "object",
      "properties": {
        "verdict": {
          "const": "block"
        },
        "reason": {
          "enum": [
            "timeout",
            "closed"
          ]
        },
        "receiptId": {
          "$ref": "hash.json"
        },
        "receipt": {
          "$ref": "receipt.json"
        }
      },
      "required": [
        "verdict",
        "reason",
        "receiptId",
        "receipt"
      ],
      "additionalProperties": false,
      "description": "A closing a close writes (close-1): a timeout of a question whose deadline it reached, or block with reason closed."
    },
    "close": {
      "description": "A close step (conformance-vectors-3, close-1): the Accord closed at at from the state the steps before it left; expect holds the outcomes of the closings it writes, in order, and the close receipt.",
      "properties": {
        "op": true,
        "at": {
          "$ref": "timestamp.json"
        },
        "expect": {
          "type": "object",
          "properties": {
            "receipts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/closeOutcome"
              }
            },
            "close": {
              "$ref": "#/$defs/closeReceipt"
            }
          },
          "required": [
            "receipts",
            "close"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "at",
        "expect"
      ],
      "additionalProperties": false
    }
  }
}
