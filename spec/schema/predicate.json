{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placket.tech/schema/0.1/predicate.json",
  "title": "Receipt predicate",
  "description": "What a receipt states about one decision (receipt-3, receipt-4, receipt-9, receipt-10, receipt-11, crossing-5). A crossing receipt's verdict is pass, block or escalate; a resolution receipt's is pass or block. pass goes with reason ok and escalate with maybe; block goes with any other reason, maybe included. declined, cancelled, timeout and undeliverable are resolution reasons only, and judge:<name> a crossing block's only. by names the decider: the terms, a judge by its card name, an answer by its call's typed hash, or the mediator with the event that made it decide, deadline or undeliverable; a judge's block is by a judge, and the verifier compares the names. prev is absent exactly when seq is 1. envelope names the envelope a receipt echoes: the key that signed it, its seq and its hash. In a crossing receipt envelope.sender is from; a schema cannot compare two members, so the verifier's statement row checks it and the rest of by's fit (receipt-3, receipt-6, receipt-11).",
  "type": "object",
  "properties": {
    "accord": {
      "$ref": "hash.json"
    },
    "card": {
      "$ref": "hash.json"
    },
    "mediator": {
      "$ref": "reference.json"
    },
    "kind": {
      "enum": [
        "crossing",
        "resolution"
      ]
    },
    "from": {
      "$ref": "reference.json"
    },
    "to": {
      "$ref": "reference.json"
    },
    "seq": {
      "$ref": "#/$defs/seq"
    },
    "prev": {
      "$ref": "hash.json"
    },
    "at": {
      "$ref": "timestamp.json"
    },
    "envelope": {
      "type": "object",
      "properties": {
        "sender": {
          "$ref": "reference.json"
        },
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "hash": {
          "$ref": "hash.json"
        }
      },
      "required": [
        "sender",
        "seq",
        "hash"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "pass",
        "block",
        "escalate"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^(?:ok|no-match|maybe|declined|cancelled|timeout|undeliverable|judge:[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "by": {
      "$ref": "#/$defs/by"
    }
  },
  "required": [
    "accord",
    "card",
    "mediator",
    "kind",
    "from",
    "to",
    "seq",
    "at",
    "envelope",
    "verdict",
    "reason",
    "by"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "prev"
          ]
        }
      },
      "else": {
        "required": [
          "prev"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "ok"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "escalate"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "crossing"
          },
          "reason": {
            "const": "maybe"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "block"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "not": {
              "const": "ok"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "crossing"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "not": {
              "enum": [
                "declined",
                "cancelled",
                "timeout",
                "undeliverable"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "pattern": "^judge:"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "crossing"
          },
          "verdict": {
            "const": "block"
          },
          "by": {
            "type": "object",
            "required": [
              "judge"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "by": {
      "description": "The decider of receipt-11: the string terms, or an object of exactly one member: judge, a judge's card name; answer, the typed hash of the answer call; or mediator, deadline or undeliverable.",
      "oneOf": [
        {
          "const": "terms"
        },
        {
          "type": "object",
          "properties": {
            "judge": {
              "$ref": "term.json#/$defs/label"
            }
          },
          "required": [
            "judge"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "answer": {
              "$ref": "hash.json"
            }
          },
          "required": [
            "answer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mediator": {
              "enum": [
                "deadline",
                "undeliverable"
              ]
            }
          },
          "required": [
            "mediator"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
